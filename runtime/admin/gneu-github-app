API = "https://api.github.com"
API_VERSION = "2026-03-10"
MAX_API_RESPONSE_BYTES = 16 * 1024 * 1024
UNSAFE_RESPONSE = "BLOCKED_UNSAFE_RESPONSE"

OWNER = "stebolainen"
REPO = "gneu-content"
GNEU_SE_REPO = "gneu-se"
GNEU_SE_FULL_REPO = f"{OWNER}/{GNEU_SE_REPO}"
GNEU_SE_INSTALLATION_ID = 155274448

PROFILE_DIRS = {
    "gneu-admin": Path("/root/.hermes/profiles/gneu-admin"),
    "gneu-forvaltare": Path("/root/.hermes/profiles/gneu-forvaltare"),
}

TOKEN_PERMISSIONS = {
    "gneu-admin": {
        "contents": "write",
        "pull_requests": "write",
        "workflows": "write",
    },
    "gneu-forvaltare": {
        "contents": "write",
        "pull_requests": "write",
    },
}

GNEU_SE_TOKEN_PERMISSIONS = {
    "actions": "read",
    "contents": "read",
    "pull_requests": "read",
}


def b64url(data: bytes) -> str:
    return base64.urlsafe_b64encode(data).decode("ascii").rstrip("=")


def secret_paths(profile: str):
    root = PROFILE_DIRS.get(profile)
    if root is None:
        raise RuntimeError("Ogiltig profil")

    sec = root / "secrets" / "github-app"
    app_id = sec / "app-id"
    private_key = sec / "private-key.pem"

    if not app_id.is_file():
        raise RuntimeError(f"App ID saknas för {profile}")
    if not private_key.is_file():
        raise RuntimeError(f"Private key saknas för {profile}")

    return app_id, private_key


def make_jwt(profile: str) -> str:
    app_id_file, key_file = secret_paths(profile)

    app_id = app_id_file.read_text(encoding="utf-8").strip()
    if not app_id.isdigit():
        raise RuntimeError("App ID är ogiltigt")

    now = int(time.time())

    header = {
        "alg": "RS256",
        "typ": "JWT",
    }

    payload = {
        "iat": now - 60,
        "exp": now + 540,
        "iss": app_id,
    }

    encoded_header = b64url(
        json.dumps(header, separators=(",", ":")).encode("utf-8")
    )
    encoded_payload = b64url(
        json.dumps(payload, separators=(",", ":")).encode("utf-8")
    )

    unsigned = f"{encoded_header}.{encoded_payload}"

    proc = subprocess.run(
        [
            "openssl",
            "dgst",
            "-sha256",
            "-sign",
            str(key_file),
            "-binary",
        ],
        input=unsigned.encode("ascii"),
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        check=False,
    )

    if proc.returncode != 0:
        raise RuntimeError("Kunde inte signera GitHub App JWT")

    return f"{unsigned}.{b64url(proc.stdout)}"


def github_request(method: str, path: str, bearer: str, body=None):
    data = None
    if body is not None:
        data = json.dumps(body, separators=(",", ":")).encode("utf-8")

    req = urllib.request.Request(
        API + path,
        data=data,
        method=method,
        headers={
            "Accept": "application/vnd.github+json",
            "Authorization": f"Bearer {bearer}",
            "X-GitHub-Api-Version": API_VERSION,
            "User-Agent": "gneu-hermes-github-app",
            "Content-Type": "application/json",
        },
    )

    try:
        with urllib.request.urlopen(req, timeout=30) as response:
            raw = response.read(MAX_API_RESPONSE_BYTES + 1)
            if len(raw) > MAX_API_RESPONSE_BYTES:
                raise RuntimeError("GitHub API response är för stor")
            if not raw:
                return None
            try:
                return json.loads(raw)
            except (UnicodeDecodeError, json.JSONDecodeError):
                raise RuntimeError(
                    "GitHub API returnerade ogiltig JSON"
                ) from None
    except urllib.error.HTTPError as exc:
        raise RuntimeError(f"GitHub API HTTP {exc.code}") from None
    except urllib.error.URLError:
        raise RuntimeError("GitHub API transportfel") from None
    except (TimeoutError, OSError):
        raise RuntimeError("GitHub API transportfel") from None


def installation(profile: str):
    jwt = make_jwt(profile)

    return github_request(
        "GET",
        f"/repos/{OWNER}/{REPO}/installation",
        jwt,
    )


def mint(profile: str):
    inst = installation(profile)

    installation_id = inst.get("id")
    if not installation_id:
        raise RuntimeError("Installation ID saknas")

    jwt = make_jwt(profile)

    result = github_request(
        "POST",
        f"/app/installations/{installation_id}/access_tokens",
        jwt,
        {
            "repositories": [REPO],
            "permissions": dict(TOKEN_PERMISSIONS[profile]),
        },
    )

    token = str(result.get("token") or "")
    if not token:
        raise RuntimeError("GitHub returnerade ingen installation token")

    return token, result, inst


def mint_gneu_se(profile: str):
    if profile != "gneu-admin":
        raise RuntimeError("Endast gneu-admin får minta gneu-se-token")

    inst = installation(profile)
    installation_id = inst.get("id")
    if installation_id != GNEU_SE_INSTALLATION_ID:
        raise RuntimeError("Fel Admin App-installation för gneu-se")

    jwt = make_jwt(profile)
    result = github_request(
        "POST",
        f"/app/installations/{installation_id}/access_tokens",
        jwt,
        {
            "repositories": [GNEU_SE_REPO],
            "permissions": dict(GNEU_SE_TOKEN_PERMISSIONS),
        },
    )

    token = str(result.get("token") or "")
    if not token:
        raise RuntimeError("GitHub returnerade ingen installation token")

    try:
        validate_gneu_se_token_permissions(result.get("permissions") or {})
    except Exception:
        revoke(token)
        raise
    return token, result, inst


def revoke(token: str):
    try:
        github_request(
            "DELETE",
            "/installation/token",
            token,
        )
    except Exception:
        # Token är kortlivad även om explicit revoke skulle misslyckas.
        pass


def validate_token_permissions(profile: str, permissions: dict):
    expected = TOKEN_PERMISSIONS[profile]

    for name, level in expected.items():
        actual = permissions.get(name)
        if actual != level:
            raise RuntimeError(
                "Installation token har fel permission "
                f"{name}: förväntat {level}, fick {actual or 'saknas'}"
            )

    if (
        profile == "gneu-forvaltare"
        and permissions.get("workflows") == "write"
    ):
        raise RuntimeError(
            "Installation token ger oväntat workflows: write till gneu-forvaltare"
        )


def validate_gneu_se_token_permissions(permissions: dict):
    allowed = set(GNEU_SE_TOKEN_PERMISSIONS) | {"metadata"}

    for name, level in GNEU_SE_TOKEN_PERMISSIONS.items():
        actual = permissions.get(name)
        if actual != level:
            raise RuntimeError(
                f"gneu-se-token har fel permission {name}"
            )

    if permissions.get("metadata", "read") != "read":
        raise RuntimeError("gneu-se-token har fel metadata-permission")

    unexpected = sorted(set(permissions) - allowed)
    if unexpected:
        raise RuntimeError("gneu-se-token har oväntade permissions")

    writable = sorted(
        name for name, level in permissions.items() if level != "read"
    )
    if writable:
        raise RuntimeError(
            "gneu-se-token har write-permissions: " + ", ".join(writable)
        )


def validate_gneu_se_repository_scope(repositories):
    repositories = repositories or {}
    names = sorted(
        str(repository.get("full_name") or "")
        for repository in repositories.get("repositories", [])
    )
    total_count = repositories.get("total_count", len(names))
    if total_count != 1 or names != [GNEU_SE_FULL_REPO]:
        raise RuntimeError("gneu-se-token har fel repository-scope")


def check(profile: str):
    token = ""
    try:
        token, result, inst = mint(profile)

        repos = github_request(
            "GET",
            "/installation/repositories",
            token,
        )

        names = [
            r.get("full_name")
            for r in (repos or {}).get("repositories", [])
        ]

        if f"{OWNER}/{REPO}" not in names:
            raise RuntimeError(
                f"Installation token saknar {OWNER}/{REPO}"
            )

        perms = result.get("permissions") or {}
        validate_token_permissions(profile, perms)

        print(f"profile: {profile}")
        print(f"app: {inst.get('app_slug', 'ok')}")
        print(f"installation: {inst.get('id')}")
        print(f"repository: {OWNER}/{REPO}")
        print(f"contents: {perms.get('contents', 'saknas')}")
        print(f"pull_requests: {perms.get('pull_requests', 'saknas')}")
        print(f"workflows: {perms.get('workflows', 'saknas')}")
        print(f"expires_at: {result.get('expires_at', 'ok')}")
        print("token: OK (värdet visas inte)")

    finally:
        if token:
            revoke(token)


def check_gneu_se(profile: str):
    token = ""
    try:
        token, result, _ = mint_gneu_se(profile)
        repositories = github_request(
            "GET",
            "/installation/repositories",
            token,
        )
        validate_gneu_se_repository_scope(repositories)

        validate_gneu_se_token_permissions(result.get("permissions") or {})
        print(f"profile: {profile}")
        print("app: gneu-admin-agent")
        print(f"installation: {GNEU_SE_INSTALLATION_ID}")
        print(f"repository: {GNEU_SE_FULL_REPO}")
        for name in sorted(GNEU_SE_TOKEN_PERMISSIONS):
            print(f"{name}: {GNEU_SE_TOKEN_PERMISSIONS[name]}")
        print("metadata: read")
        print("token: OK (värdet visas inte)")
    finally:
        if token:
            revoke(token)


BRANCH_PREFIXES = {
    "gneu-admin": "admin/",
    "gneu-forvaltare": "forvaltare/",
}

PR_BASES = {
    "gneu-admin": "main",
    "gneu-forvaltare": "published",
}


def _flag_value(args, flag):
    for i, arg in enumerate(args):
        if arg == flag and i + 1 < len(args):
            return args[i + 1]
        if arg.startswith(flag + "="):
            return arg.split("=", 1)[1]
    return None


def _validate_branch(profile: str, branch: str):
    prefix = BRANCH_PREFIXES[profile]

    branch = str(branch).strip()
    if branch.startswith("refs/heads/"):
        branch = branch[len("refs/heads/"):]

    if (
        not branch.startswith(prefix)
        or branch == prefix
        or ".." in branch
        or branch.startswith("/")
        or branch.endswith("/")
        or not all(c.isalnum() or c in "._/-" for c in branch)
    ):
        raise RuntimeError(
            f"Policy blockerar branch '{branch}'. Tillåtet prefix: {prefix}"
        )

    return branch


def _positive_id(value: str, label: str):
    value = str(value)
    if not value.isascii() or not value.isdigit() or int(value) < 1:
        raise RuntimeError(f"{label} måste vara ett positivt heltal")
    return value


def _safe_name(value: str, label: str):
    value = str(value)
    if (
        not value
        or len(value) > 255
        or value.startswith("/")
        or value.endswith("/")
        or ".." in value.split("/")
        or not all(c.isalnum() or c in "._/-" for c in value)
    ):
        raise RuntimeError(f"Ogiltigt {label}")
    return value


def gneu_se_read_path(operation: str, args):
    args = list(args)
    base = f"/repos/{OWNER}/{GNEU_SE_REPO}"

    if operation == "repo":
        if args:
            raise RuntimeError("repo tar inga argument")
        return base

    if operation in {"workflow-run", "workflow-jobs"}:
        if len(args) != 1:
            raise RuntimeError(f"{operation} kräver exakt ett run-id")
        run_id = _positive_id(args[0], "run-id")
        suffix = "" if operation == "workflow-run" else "/jobs"
        return f"{base}/actions/runs/{run_id}{suffix}"

    if operation == "workflow-job":
        if len(args) != 1:
            raise RuntimeError("workflow-job kräver exakt ett job-id")
        job_id = _positive_id(args[0], "job-id")
        return f"{base}/actions/jobs/{job_id}"

    if operation == "pr-list":
        if args:
            raise RuntimeError("pr-list tar inga argument")
        return f"{base}/pulls?state=open&per_page=100"

    if operation == "pr-view":
        if len(args) != 1:
            raise RuntimeError("pr-view kräver exakt ett PR-nummer")
        number = _positive_id(args[0], "PR-nummer")
        return f"{base}/pulls/{number}"

    if operation == "branch":
        if len(args) != 1:
            raise RuntimeError("branch kräver exakt ett branchnamn")
        branch = _safe_name(args[0], "branchnamn")
        return f"{base}/branches/{urllib.parse.quote(branch, safe='')}"

    if operation == "ref":
        if len(args) != 1:
            raise RuntimeError("ref kräver exakt en heads/ eller tags-ref")
        ref = _safe_name(args[0], "ref")
        if not (ref.startswith("heads/") or ref.startswith("tags/")):
            raise RuntimeError("Endast heads/ och tags/ refs är tillåtna")
        return f"{base}/git/ref/{urllib.parse.quote(ref, safe='/')}"

    if operation == "contents":
        if len(args) not in {1, 3}:
            raise RuntimeError("contents kräver PATH och valfritt --ref REF")
        path = str(args[0])
        if path == ".":
            path = ""
        elif (
            not path
            or len(path) > 1024
            or path.startswith("/")
            or ".." in path.split("/")
            or any(ord(c) < 32 for c in path)
        ):
            raise RuntimeError("Ogiltig contents-path")

        endpoint = f"{base}/contents"
        if path:
            endpoint += "/" + urllib.parse.quote(path, safe="/")

        if len(args) == 3:
            if args[1] != "--ref":
                raise RuntimeError("Endast --ref är tillåtet för contents")
            ref = _safe_name(args[2], "contents-ref")
            endpoint += "?ref=" + urllib.parse.quote(ref, safe="")
        return endpoint

    raise RuntimeError("gneu-se-operation är blockerad eller okänd")


def _unsafe_response():
    raise RuntimeError(UNSAFE_RESPONSE)


def _response_dict(value):
    if type(value) is not dict:
        _unsafe_response()
    return value


def _response_list(value):
    if type(value) is not list:
        _unsafe_response()
    return value


def _response_field(obj, name, expected_type, nullable=False):
    obj = _response_dict(obj)
    if name not in obj:
        _unsafe_response()
    value = obj[name]
    if nullable and value is None:
        return None
    if expected_type is int:
        valid = type(value) is int
    elif expected_type is bool:
        valid = type(value) is bool
    else:
        valid = type(value) is expected_type
    if not valid:
        _unsafe_response()
    return value


def _response_text(obj, name, nullable=False, max_length=4096):
    value = _response_field(obj, name, str, nullable=nullable)
    if value is None:
        return None
    if not value or len(value) > max_length or any(ord(c) < 32 for c in value):
        _unsafe_response()
    return value


def _response_id(obj, name):
    value = _response_field(obj, name, int)
    if value < 1:
        _unsafe_response()
    return value


def _response_count(obj, name):
    value = _response_field(obj, name, int)
    if value < 0:
        _unsafe_response()
    return value


def _response_sha(obj, name):
    value = _response_text(obj, name, max_length=64)
    if len(value) != 40 or any(c not in "0123456789abcdef" for c in value):
        _unsafe_response()
    return value


def _response_timestamp(obj, name, nullable=False):
    value = _response_text(obj, name, nullable=nullable, max_length=64)
    if value is None:
        return None
    allowed = set("0123456789TtZz:+-.")
    if any(c not in allowed for c in value):
        _unsafe_response()
    return value


def _project_repo(result):
    result = _response_dict(result)
    owner = _response_field(result, "owner", dict)
    full_name = _response_text(result, "full_name", max_length=255)
    name = _response_text(result, "name", max_length=255)
    owner_login = _response_text(owner, "login", max_length=255)
    if (
        full_name != GNEU_SE_FULL_REPO
        or name != GNEU_SE_REPO
        or owner_login != OWNER
    ):
        _unsafe_response()
    return {
        "archived": _response_field(result, "archived", bool),
        "default_branch": _response_text(result, "default_branch", max_length=255),
        "disabled": _response_field(result, "disabled", bool),
        "full_name": full_name,
        "name": name,
        "owner": {
            "login": owner_login,
        },
        "private": _response_field(result, "private", bool),
    }


def _project_workflow_run(result):
    result = _response_dict(result)
    return {
        "conclusion": _response_text(
            result, "conclusion", nullable=True, max_length=64
        ),
        "created_at": _response_timestamp(result, "created_at"),
        "event": _response_text(result, "event", max_length=64),
        "head_branch": _response_text(
            result, "head_branch", nullable=True, max_length=255
        ),
        "head_sha": _response_sha(result, "head_sha"),
        "id": _response_id(result, "id"),
        "name": _response_text(result, "name", max_length=255),
        "run_attempt": _response_id(result, "run_attempt"),
        "run_number": _response_id(result, "run_number"),
        "run_started_at": _response_timestamp(
            result, "run_started_at", nullable=True
        ),
        "status": _response_text(result, "status", max_length=64),
        "updated_at": _response_timestamp(result, "updated_at"),
        "workflow_id": _response_id(result, "workflow_id"),
    }


def _project_step(step):
    step = _response_dict(step)
    return {
        "completed_at": _response_timestamp(
            step, "completed_at", nullable=True
        ),
        "conclusion": _response_text(
            step, "conclusion", nullable=True, max_length=64
        ),
        "name": _response_text(step, "name", max_length=255),
        "number": _response_id(step, "number"),
        "started_at": _response_timestamp(step, "started_at", nullable=True),
        "status": _response_text(step, "status", max_length=64),
    }


def _project_job(job):
    job = _response_dict(job)
    steps = _response_field(job, "steps", list)
    return {
        "completed_at": _response_timestamp(
            job, "completed_at", nullable=True
        ),
        "conclusion": _response_text(
            job, "conclusion", nullable=True, max_length=64
        ),
        "head_sha": _response_sha(job, "head_sha"),
        "id": _response_id(job, "id"),
        "name": _response_text(job, "name", max_length=255),
        "started_at": _response_timestamp(job, "started_at", nullable=True),
        "status": _response_text(job, "status", max_length=64),
        "steps": [_project_step(step) for step in steps],
    }


def _project_workflow_jobs(result):
    result = _response_dict(result)
    total_count = _response_count(result, "total_count")
    jobs = [_project_job(job) for job in _response_field(result, "jobs", list)]
    if total_count < len(jobs):
        _unsafe_response()
    return {
        "jobs": jobs,
        "total_count": total_count,
    }


def _project_pull_request(pull):
    pull = _response_dict(pull)
    user = _response_field(pull, "user", dict)
    base = _response_field(pull, "base", dict)
    head = _response_field(pull, "head", dict)
    return {
        "base": {
            "ref": _response_text(base, "ref", max_length=255),
            "sha": _response_sha(base, "sha"),
        },
        "created_at": _response_timestamp(pull, "created_at"),
        "draft": _response_field(pull, "draft", bool),
        "head": {
            "ref": _response_text(head, "ref", max_length=255),
            "sha": _response_sha(head, "sha"),
        },
        "merged_at": _response_timestamp(pull, "merged_at", nullable=True),
        "number": _response_id(pull, "number"),
        "state": _response_text(pull, "state", max_length=32),
        "title": _response_text(pull, "title", max_length=512),
        "updated_at": _response_timestamp(pull, "updated_at"),
        "user": {
            "login": _response_text(user, "login", max_length=255),
        },
    }


def _project_branch(result):
    result = _response_dict(result)
    commit = _response_field(result, "commit", dict)
    return {
        "commit": {
            "sha": _response_sha(commit, "sha"),
        },
        "name": _response_text(result, "name", max_length=255),
        "protected": _response_field(result, "protected", bool),
    }


def _project_ref(result):
    result = _response_dict(result)
    target = _response_field(result, "object", dict)
    return {
        "object": {
            "sha": _response_sha(target, "sha"),
            "type": _response_text(target, "type", max_length=32),
        },
        "ref": _response_text(result, "ref", max_length=512),
    }


def _project_content_entry(entry):
    entry = _response_dict(entry)
    kind = _response_text(entry, "type", max_length=32)
    if kind not in {"dir", "file", "submodule", "symlink"}:
        _unsafe_response()
    return {
        "name": _response_text(entry, "name", max_length=1024),
        "path": _response_text(entry, "path", max_length=4096),
        "sha": _response_sha(entry, "sha"),
        "size": _response_count(entry, "size"),
        "type": kind,
    }


def _project_contents(result):
    if type(result) is list:
        return [_project_content_entry(entry) for entry in result]

    result = _response_dict(result)
    projected = _project_content_entry(result)
    if projected["type"] != "file":
        _unsafe_response()
    encoding = _response_text(result, "encoding", max_length=32)
    if encoding != "base64":
        _unsafe_response()
    content = _response_field(result, "content", str)
    if len(content) > MAX_API_RESPONSE_BYTES:
        _unsafe_response()
    projected["content"] = content
    projected["encoding"] = encoding
    return projected


def project_gneu_se_response(operation: str, result):
    if operation == "repo":
        return _project_repo(result)
    if operation == "workflow-run":
        return _project_workflow_run(result)
    if operation == "workflow-jobs":
        return _project_workflow_jobs(result)
    if operation == "workflow-job":
        return _project_job(result)
    if operation == "pr-list":
        return [_project_pull_request(pull) for pull in _response_list(result)]
    if operation == "pr-view":
        return _project_pull_request(result)
    if operation == "branch":
        return _project_branch(result)
    if operation == "ref":
        return _project_ref(result)
    if operation == "contents":
        return _project_contents(result)
    _unsafe_response()


FORBIDDEN_OUTPUT_KEYS = {
    "access_token",
    "authorization",
    "credential",
    "download_url",
    "sig",
    "signature",
    "signed",
    "temp_clone_token",
    "token",
}


def _signed_url(value: str):
    try:
        parsed = urllib.parse.urlsplit(value)
    except ValueError:
        return False
    if parsed.scheme.lower() not in {"http", "https"} or not parsed.netloc:
        return False
    try:
        query = urllib.parse.parse_qsl(parsed.query, keep_blank_values=True)
    except ValueError:
        return True
    for name, _ in query:
        normalized = name.casefold().replace("-", "_")
        if (
            normalized in {"sig", "signature", "token", "access_token"}
            or normalized.startswith("x_amz_")
            or normalized.startswith("x_goog_")
        ):
            return True
    return False


def guard_gneu_se_output(value, parent_key=None):
    if type(value) is dict:
        for key, item in value.items():
            if type(key) is not str:
                _unsafe_response()
            normalized = key.casefold().replace("-", "_")
            if (
                normalized in FORBIDDEN_OUTPUT_KEYS
                or normalized.startswith("x_amz_")
                or normalized.startswith("x_goog_")
            ):
                _unsafe_response()
            guard_gneu_se_output(item, key)
        return
    if type(value) is list:
        for item in value:
            guard_gneu_se_output(item, parent_key)
        return
    if type(value) is str:
        if parent_key != "content" and _signed_url(value):
            _unsafe_response()
        return
    if value is None or type(value) in {bool, int}:
        return
    _unsafe_response()


def serialize_gneu_se_response(operation: str, result):
    projected = project_gneu_se_response(operation, result)
    guard_gneu_se_output(projected)
    return json.dumps(
        projected,
        ensure_ascii=False,
        separators=(",", ":"),
        sort_keys=True,
    )


def read_gneu_se(profile: str, operation: str, args):
    path = gneu_se_read_path(operation, args)
    token = ""
    try:
        token, _, _ = mint_gneu_se(profile)
        repositories = github_request(
            "GET",
            "/installation/repositories",
            token,
        )
        validate_gneu_se_repository_scope(repositories)
        result = github_request("GET", path, token)
        safe_output = serialize_gneu_se_response(operation, result)
        print(safe_output)
    finally:
        if token:
            revoke(token)


def authorize_command(profile: str, command):
    if not command:
        raise RuntimeError("Kommando saknas")

    exe = Path(command[0]).name
    args = list(command[1:])

    if exe == "git":
        if not args:
            raise RuntimeError("Git-operation saknas")

        op = args[0]

        # Läsande nätverksoperationer.
        if op in {"ls-remote", "fetch"}:
            return

        if op != "push":
            raise RuntimeError(
                f"Git-operation '{op}' är inte tillåten genom credential-wrappern"
            )

        push_args = args[1:]

        forbidden = (
            "--force", "-f", "--force-with-lease",
            "--mirror", "--all", "--tags",
        )
        for arg in push_args:
            if any(arg == x or arg.startswith(x + "=") for x in forbidden):
                raise RuntimeError("Force/bred Git-push är blockerad")

        delete = "--delete" in push_args or "-d" in push_args

        safe_options = {
            "-u", "--set-upstream",
            "--dry-run",
            "--porcelain",
            "--verbose", "-v",
            "--delete", "-d",
        }

        positional = []
        for arg in push_args:
            if arg in safe_options:
                continue
            if arg.startswith("-"):
                raise RuntimeError(f"Otillåtet git push-argument: {arg}")
            positional.append(arg)

        if len(positional) != 2:
            raise RuntimeError(
                "Tillåten push-form är: git push [options] origin <branch/refspec>"
            )

        remote, refspec = positional

        if remote != "origin":
            raise RuntimeError("Endast Git-remote 'origin' är tillåten")

        if ":" in refspec:
            source, destination = refspec.split(":", 1)
            if not destination:
                raise RuntimeError("Push-destination saknas")
            if not source and not delete:
                raise RuntimeError("Implicit branch-radering är blockerad")
            branch = destination
        else:
            branch = refspec

        _validate_branch(profile, branch)
        return

    if exe == "gh":
        if len(args) < 2 or args[0] != "pr":
            raise RuntimeError("Endast begränsade 'gh pr'-operationer är tillåtna")

        operation = args[1]

        repo = _flag_value(args, "--repo")
        if repo and repo != f"{OWNER}/{REPO}":
            raise RuntimeError("Endast stebolainen/gneu-content är tillåtet")

        if operation in {"list", "view", "status", "checks"}:
            return

        if operation == "create":
            base = _flag_value(args, "--base")
            head = _flag_value(args, "--head")

            if base != PR_BASES[profile]:
                raise RuntimeError(
                    f"PR base måste vara {PR_BASES[profile]}"
                )

            if not head:
                raise RuntimeError("PR måste ange --head explicit")

            _validate_branch(profile, head)
            return

        raise RuntimeError(
            f"'gh pr {operation}' är blockerad. Merge/close/edit är inte tillåtet."
        )

    raise RuntimeError(
        f"Programmet '{exe}' får inte använda GitHub-credential-wrappern"
    )


def execute(profile: str, command):
    authorize_command(profile, command)

    token = ""

    try:
        token, _, _ = mint(profile)

        env = os.environ.copy()

        # GitHub CLI använder dessa utan att token sparas i gh-config.
        env["GH_TOKEN"] = token
        env["GITHUB_TOKEN"] = token

        # Git över HTTPS får token via temporär processmiljö.
        # Token hamnar inte i remote-URL eller .gitconfig.
        basic = base64.b64encode(
            f"x-access-token:{token}".encode("utf-8")
        ).decode("ascii")

        try:
            count = int(env.get("GIT_CONFIG_COUNT", "0"))
        except ValueError:
            count = 0

        env["GIT_CONFIG_COUNT"] = str(count + 1)
        env[f"GIT_CONFIG_KEY_{count}"] = (
            "http.https://github.com/.extraheader"
        )
        env[f"GIT_CONFIG_VALUE_{count}"] = (
            f"AUTHORIZATION: Basic {basic}"
        )

        proc = subprocess.run(
            command,
            env=env,
            check=False,
        )

        return proc.returncode

    finally:
        if token:
            revoke(token)


class TechnicalPRError(RuntimeError):
    """Only constant, non-response error codes may cross this boundary."""


def technical_block(code="BLOCKED_TECHNICAL_PR"):
    raise TechnicalPRError(code)


def technical_request(value):
    keys = {"expected_main_sha", "branch", "title", "message", "files"}
    if type(value) is not dict or set(value) != keys:
        technical_block()
    sha = value["expected_main_sha"]
    branch = value["branch"]
    if type(sha) is not str or not re.fullmatch(r"[0-9a-f]{40}", sha):
        technical_block()
    if (type(branch) is not str or len(branch) > 120
            or not re.fullmatch(r"admin/[a-z0-9]+(?:-[a-z0-9]+)*", branch)):
        technical_block()
    for name in ("title", "message"):
        text = value[name]
        if (type(text) is not str or not 1 <= len(text) <= 160
                or any(ord(c) < 32 for c in text)):
            technical_block()
        technical_output_guard(text)
    files = value["files"]
    if type(files) is not list or not 1 <= len(files) <= 40:
        technical_block()
    seen = set()
    total = 0
    for row in files:
        if type(row) is not dict or set(row) != {"path", "content"}:
            technical_block()
        path, content = row["path"], row["content"]
        if (type(path) is not str or len(path) > 240
                or not re.fullmatch(r"[A-Za-z0-9_.-]+(?:/[A-Za-z0-9_.-]+)*", path)
                or any(p in {".", "..", ".git"} for p in path.split("/"))
                or path in seen):
            technical_block()
        # Positive technical path policy. All data/, aihot/, sitemap and
        # website/publication paths are excluded, including unknown new ones.
        allowed = (
            re.fullmatch(r"scripts/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\.(?:py|php|sh|json|md)", path)
            or re.fullmatch(r"docs/(?:[A-Za-z0-9_-]+/)*[A-Za-z0-9_.-]+\.md", path)
            or re.fullmatch(r"\.github/workflows/[A-Za-z0-9_-]+\.ya?ml", path)
            or re.fullmatch(r"test_[A-Za-z0-9_]+\.py", path)
        )
        if not allowed or path.lower() in {"scripts/config.php"}:
            technical_block()
        if any(p.lower() in {"credentials", "secrets", ".env"} for p in path.split("/")):
            technical_block()
        if type(content) is not str or "\0" in content:
            technical_block()
        size = len(content.encode("utf-8"))
        if size > 200_000:
            technical_block()
        total += size
        if total > 800_000:
            technical_block()
        technical_output_guard(content)
        seen.add(path)
    return value


def technical_output_guard(value):
    # Supplement the existing structural guard with credential-shaped strings.
    try:
        guard_gneu_se_output(value)
    except RuntimeError:
        technical_block()
    raw = json.dumps(value, ensure_ascii=False)
    if re.search(r"-----BEGIN [A-Z ]*PRIVATE KEY-----|\b(?:gh[pousr]_[A-Za-z0-9]{20,}|github_pat_[A-Za-z0-9_]{20,})|\beyJ[A-Za-z0-9_-]+\.eyJ[A-Za-z0-9_-]+\.[A-Za-z0-9_-]+", raw):
        technical_block()
    if re.search(r"https?://[^\s]+[?&](?:sig|signature|token|access_token|x-amz-[a-z-]+|x-goog-[a-z-]+)=", raw, re.I):
        technical_block()


def load_technical_request(path):
    def pairs(items):
        result = {}
        for key, value in items:
            if key in result:
                technical_block()
            result[key] = value
        return result
    fd = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
    with os.fdopen(fd, "rb") as handle:
        info = os.fstat(handle.fileno())
        if not stat.S_ISREG(info.st_mode) or not 0 < info.st_size <= 1_000_000:
            technical_block()
        raw = handle.read(1_000_001)
    if len(raw) > 1_000_000:
        technical_block()
    return technical_request(json.loads(raw, object_pairs_hook=pairs))


def mint_gneu_se_technical(profile, workflows):
    if profile != "gneu-admin" or type(workflows) is not bool:
        technical_block()
    inst = installation(profile)
    if inst.get("id") != GNEU_SE_INSTALLATION_ID:
        technical_block()
    permissions = {"contents": "write", "pull_requests": "write"}
    if workflows:
        permissions["workflows"] = "write"
    result = github_request("POST", f"/app/installations/{GNEU_SE_INSTALLATION_ID}/access_tokens",
                            make_jwt(profile), {"repositories": [GNEU_SE_REPO], "permissions": permissions})
    token = result.get("token")
    if type(token) is not str or not token:
        technical_block()
    try:
        actual = result.get("permissions")
        if (type(actual) is not dict or actual.get("metadata", "read") != "read"
                or {k: v for k, v in actual.items() if k != "metadata"} != permissions):
            technical_block("BLOCKED_TOKEN_PERMISSIONS")
        validate_gneu_se_repository_scope(github_request("GET", "/installation/repositories", token))
    except Exception:
        revoke(token)
        raise
    return token


def technical_tree(result):
    if type(result) is not dict or result.get("truncated") is not False or type(result.get("tree")) is not list:
        technical_block()
    entries = {}
    for row in result["tree"]:
        if type(row) is not dict:
            technical_block()
        path = row.get("path")
        if type(path) is not str or path in entries:
            technical_block()
        sha = _response_sha(row, "sha")
        entries[path] = (row.get("mode"), row.get("type"), sha)
    return entries


def create_gneu_se_technical_pr(profile, request):
    # All caller data is validated before mint. No command/URL/refspec input.
    request = technical_request(request)
    if profile != "gneu-admin":
        technical_block()
    expected, branch = request["expected_main_sha"], request["branch"]
    root = f"/repos/{GNEU_SE_FULL_REPO}"
    token = ""
    try:
        token = mint_gneu_se_technical(profile, any(
            row["path"].startswith(".github/workflows/") for row in request["files"]))

        def get(suffix):
            return github_request("GET", root + suffix, token)

        def current_main():
            ref = get("/git/ref/heads/main")
            if (ref.get("ref") != "refs/heads/main" or ref.get("object", {}).get("type") != "commit"
                    or _response_sha(ref["object"], "sha") != expected):
                technical_block("STALE_BASE")

        def branch_absent():
            # List matching refs: an empty list is authoritative absence;
            # do not interpret arbitrary HTTP errors as absent.
            refs = get("/git/matching-refs/heads/" + branch)
            if type(refs) is not list or refs:
                technical_block("BRANCH_EXISTS_OR_AMBIGUOUS")

        def post(suffix, body):
            current_main()  # Recheck before EVERY repository mutation.
            return github_request("POST", root + suffix, token, body)

        current_main()
        branch_absent()
        pulls = get("/pulls?state=all&head=" + OWNER + ":" + branch + "&per_page=1")
        if type(pulls) is not list or pulls:
            technical_block()
        parent = get("/git/commits/" + expected)
        if _response_sha(parent, "sha") != expected:
            technical_block()
        tree_sha = _response_sha(parent["tree"], "sha")
        original = technical_tree(get("/git/trees/" + tree_sha + "?recursive=1"))
        delta = {}
        for row in request["files"]:
            path = row["path"]
            parts = path.split("/")
            for i in range(1, len(parts)):
                ancestor = original.get("/".join(parts[:i]))
                if ancestor is not None and ancestor[:2] != ("040000", "tree"):
                    technical_block()
            previous = original.get(path)
            if previous is not None and previous[:2] != ("100644", "blob"):
                technical_block()  # no symlink, submodule, executable/mode changes
            raw = row["content"].encode("utf-8")
            blob = hashlib.sha1(b"blob " + str(len(raw)).encode() + b"\0" + raw).hexdigest()
            delta[path] = ("100644", "blob", blob)
        if all(original.get(path) == entry for path, entry in delta.items()):
            technical_block("NO_CHANGE")
        branch_absent()
        tree = post("/git/trees", {"base_tree": tree_sha, "tree": [
            {"path": row["path"], "mode": "100644", "type": "blob", "content": row["content"]}
            for row in request["files"]]})
        new_tree = _response_sha(tree, "sha")
        actual = technical_tree(get("/git/trees/" + new_tree + "?recursive=1"))
        wanted = {p: e for p, e in original.items() if e[1] != "tree"}
        wanted.update(delta)
        if {p: e for p, e in actual.items() if e[1] != "tree"} != wanted:
            technical_block()
        commit = post("/git/commits", {"message": request["message"], "tree": new_tree, "parents": [expected]})
        commit_sha = _response_sha(commit, "sha")
        check = get("/git/commits/" + commit_sha)
        if (check.get("tree", {}).get("sha") != new_tree
                or [p.get("sha") for p in check.get("parents", [])] != [expected]):
            technical_block()
        branch_absent()
        ref = post("/git/refs", {"ref": "refs/heads/" + branch, "sha": commit_sha})
        if ref.get("ref") != "refs/heads/" + branch or ref.get("object", {}).get("sha") != commit_sha:
            technical_block()
        # Create-only refs; there is no PATCH, force update or branch cleanup.
        readback = get("/git/ref/heads/" + branch)
        if readback.get("object", {}).get("sha") != commit_sha:
            technical_block()
        pull = post("/pulls", {"title": request["title"], "head": branch, "base": "main",
                              "body": "Technical Admin proposal. Human review and merge required."})
        number = _response_id(pull, "number")
        pull = get("/pulls/" + str(number))
        if (pull.get("head", {}).get("sha") != commit_sha or pull.get("head", {}).get("ref") != branch
                or pull.get("base", {}).get("ref") != "main" or pull.get("base", {}).get("sha") != expected
                or pull.get("state") != "open"):
            technical_block()
        current_main()
        safe = {"repo": GNEU_SE_FULL_REPO, "branch": branch, "expected_main_sha": expected,
                "current_main_sha": expected, "commit_sha": commit_sha, "pr_number": number,
                "pr_title": request["title"], "head": branch, "base": "main", "state": "open"}
        technical_output_guard(safe)
        return safe
    finally:
        if token:
            revoke(token)


def technical_pr_cli(profile, args):
    try:
        if profile != "gneu-admin" or len(args) != 3 or args[0] not in {"check", "create"} or args[1] != "--request":
            technical_block()
        request = load_technical_request(args[2])
        if args[0] == "check":
            print("TECHNICAL_PR_LOCAL_POLICY_PASS")  # no network/mint/write
        else:
            print(json.dumps(create_gneu_se_technical_pr(profile, request), sort_keys=True, separators=(",", ":")))
        return 0
    except Exception as exc:
        # Never expose exception text from files, API, JWT/signing or response.
        code = str(exc) if type(exc) is TechnicalPRError else "BLOCKED_TECHNICAL_PR"
        if code not in {"BLOCKED_TECHNICAL_PR", "STALE_BASE", "BRANCH_EXISTS_OR_AMBIGUOUS", "BLOCKED_TOKEN_PERMISSIONS", "NO_CHANGE"}:
            code = "BLOCKED_TECHNICAL_PR"
        print(code, file=sys.stderr)
        return 1


def main():
    if len(sys.argv) < 3:
        print(
            "usage: gneu-github-app PROFILE check | "
            "exec -- COMMAND... | gneu-se-check | "
            "gneu-se-read OPERATION [ARGS...] | "
            "gneu-se-admin-pr check|create --request FILE",
            file=sys.stderr,
        )
        return 2

    profile = sys.argv[1]
    action = sys.argv[2]

    if profile not in PROFILE_DIRS:
        print("Ogiltig profil", file=sys.stderr)
        return 2

    try:
        if action == "gneu-se-admin-pr":
            return technical_pr_cli(profile, sys.argv[3:])

        if action == "check":
            check(profile)
            return 0

        if action == "gneu-se-check":
            check_gneu_se(profile)
            return 0

        if action == "gneu-se-read":
            if len(sys.argv) < 4:
                raise RuntimeError("gneu-se-read kräver en namngiven operation")
            read_gneu_se(profile, sys.argv[3], sys.argv[4:])
            return 0

        if action == "exec":
            command = sys.argv[3:]
            if command and command[0] == "--":
                command = command[1:]
            return execute(profile, command)

        raise RuntimeError("Ogiltig operation")

    except Exception as exc:
        print(f"FEL: {exc}", file=sys.stderr)
        return 1


if __name__ == "__main__":
    raise SystemExit(main())
